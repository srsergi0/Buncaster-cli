# =============================================================
# BunRadio - Configuración (TODO es opcional)
# =============================================================
# Ejecuta el binario sin .env y funciona automáticamente.
# Solo edita lo que quieras cambiar.

# Puerto HTTP (auto-detectado si está ocupado)
# PORT=8080

# Puerto RTMP (auto-detectado si está ocupado)
# RTMP_PORT=1935

# Puerto SRT (UDP, sin plan B, reemplaza RTMP)
# SRT_PORT=1936

# Clave de transmisión (se genera automáticamente si no la pones)
# RTMP_STREAM_KEY=stream

# Límite de oyentes simultáneos
# MAX_LISTENERS=500

# Búfer inicial para reproducción inmediata (8192 low-latency, 65536 legacy)
# PREBUFFER_BYTES=8192

# CORS (orígenes permitidos)
# CORS_ORIGIN=*

# Nivel de logs: debug | info | warn | error
# LOG_LEVEL=info

# Bitrate de audio (128, 192, 320 para MP3/AAC/Opus, ignorado para FLAC/OGG)
# STREAM_BITRATE_KBPS=320

# Carpeta de música fallback (por defecto: directorio donde se ejecuta el binario)
# "" → live-only (silence until SRT live), sin necesidad de carpeta
# FALLBACK_SOURCE=musica
# FALLBACK_SOURCE=""

# Crossfade entre canciones en segundos (0 = desactivado)
# CROSSFADE_SECONDS=1 (low-latency) / 2 legacy
# CROSSFADE_SECONDS=1

# Crossfade al entrar vivo (SRT) en segundos
# CROSSFADE_LIVE_SECONDS=0.2 (low-latency) / 2 legacy

# Tiempo mínimo de stream antes de cortar fallback (segundos, 0 = instant con low-latency)
# RTMP_MIN_LIVE_SECONDS=0

# Codificación MP3 nativa via FFI:
#   auto  → intenta nativo, fallback ffmpeg (recomendado)
#   true  → fuerza nativo
#   false → usa ffmpeg
# USE_NATIVE_LAME=auto

# Decodificación nativa de los decks via FFI (libavformat/libavcodec):
# elimina el proceso ffmpeg de cada canción (PCM idéntico a ffmpeg CLI, mismo ritmo que -re).
# Requiere libavformat 60 (ffmpeg 6.x) y Bun >= 1.3; si no, ffmpeg CLI automáticamente.
#   auto  → intenta nativo, fallback ffmpeg por pista (recomendado)
#   true  → igual que auto (avisa si no puede)
#   false → usa ffmpeg CLI siempre
# USE_NATIVE_DECODE=auto

# Low-latency pipeline (prebuffer 8K, crossfade corto, SRT rcvlatency 20ms)
# LOW_LATENCY=true

# Dual-tier per-listener: mp3 320k + opus 96k, clientes eligen /stream?format=opus (10× eficiencia)
# ENABLE_OPUS_TIER=true
# OPUS_TIER_BITRATE_KBPS=96

# --- Motor (docs/ENGINE-ROUNDTABLE.md) ---
# Prebuffer en segundos por tier (0 = usar PREBUFFER_BYTES). Recomendado 10.
# PREBUFFER_SECONDS=0
# Normalización de sonoridad por pista (BS.1770, ganancia estática, sin compresión)
# LOUDNESS_NORMALIZATION=false
# LOUDNESS_TARGET_LUFS=-16
# LOUDNESS_TRUE_PEAK_DBTP=-1
# LOUDNESS_MAX_GAIN_DB=12
# Transiciones por energía (salta intro muda, cruza al empezar el silencio final)
# SMART_TRANSITIONS=false
# SILENCE_THRESHOLD_DB=-50
# ANALYSIS_PRESCAN=true
# ANALYSIS_CACHE_FILE=.analysis-cache.json
# Crossfade por muestras + relevo sin pérdidas (false = comportamiento anterior)
# CROSSFADE_SAMPLE_CLOCK=true
# true = comportamiento anterior (recorta ~1.2 s al inicio de cada MP3)
# DECK_FFLAGS_NOBUFFER=false
# Watchdog de fallback colgado (segundos sin PCM; 0 = off)
# FALLBACK_STALL_SECONDS=5
# Reinicio supervisado del encoder opus
# ENCODER_SUPERVISION=true

# --- Bun way (docs/ENGINE-BUN-WAY.md) ---
# Lote de PCM hacia los encoders en ms (mismos bytes de salida; 0 = un write por trozo)
# ENCODER_BATCH_MS=100
# No codificar MP3 sin oyentes /mp3 (30 s de gracia); el prebuffer se recodifica al llegar uno
# MP3_ON_DEMAND=false
# No mantener un ffmpeg SRT escuchando: un socket UDP de Bun lo lanza al primer paquete (+0,3 s al entrar en directo)
# SRT_ON_DEMAND=false

# --- MoQ / WebTransport (docs/ENGINE-MOQ.md) — todo apagado por defecto ---
# Publica el audio (Opus por FFI, tramas de 20 ms) a un sidecar moq-relay (moq/relay/)
# para oyentes WebTransport con < 0,5 s de retraso. El stream HTTP no cambia.
# MOQ_ENABLED=false
# Dónde publica el motor (WebSocket interno del relay; NO publicar ese puerto al host)
# MOQ_RELAY_URL=http://moq-relay:4434
# URL WebTransport que se anuncia a los navegadores (vacío = https://<Host>:4433)
# MOQ_PUBLIC_URL=https://185.139.1.222:4433
# MOQ_PATH=bloom
# MOQ_BROADCAST=radio.hang
# Opus del canal MoQ (PEAQ: 128k ODG −0,15…−0,43; 96k −0,45…−0,89). FEC: medido dañino para música.
# MOQ_OPUS_BITRATE_KBPS=128
# MOQ_OPUS_FRAME_MS=20
# MOQ_OPUS_FEC=false
# MOQ_OPUS_PACKET_LOSS_PERC=0
# MOQ_GROUP_MS=100
# MOQ_MAX_AGE_MS=1000
# MOQ_CLIENT_TARGET_MS=250
# Secretos compartidos con el relay (volumen, fuera del repo): cert/clave efímeros y clave JWT
# MOQ_CERT_DIR=/moq-secrets
# MOQ_CERT_DAYS=10
# MOQ_CERT_ROTATE_DAYS=5
# MOQ_CERT_NAMES=localhost,185.139.1.222
# MOQ_SECRETS_UID=10001
# URL del stream HTTP de respaldo que usa el cliente si MoQ falla
# MOQ_FALLBACK_URL=/opus
# Solo pruebas: POST /admin/api/moq/probe inyecta un tono marcador (¡suena en el aire!)
# MOQ_LATENCY_PROBE=false

# =============================================================
# BunRadio - Configuración (TODO es opcional)
# =============================================================
# Ejecuta el binario sin .env y funciona automáticamente.
# Solo edita lo que quieras cambiar.

# Puerto HTTP (auto-detectado si está ocupado)
# PORT=8080

# Puerto RTMP (auto-detectado si está ocupado)
# RTMP_PORT=1935

# Puerto SRT (UDP, sin plan B, reemplaza RTMP)
# SRT_PORT=1936

# Clave de transmisión (se genera automáticamente si no la pones)
# RTMP_STREAM_KEY=stream

# Límite de oyentes simultáneos
# MAX_LISTENERS=500

# Búfer inicial para reproducción inmediata (8192 low-latency, 65536 legacy)
# PREBUFFER_BYTES=8192

# CORS (orígenes permitidos)
# CORS_ORIGIN=*

# Nivel de logs: debug | info | warn | error
# LOG_LEVEL=info

# Bitrate de audio (128, 192, 320 para MP3/AAC/Opus, ignorado para FLAC/OGG)
# STREAM_BITRATE_KBPS=320

# Carpeta de música fallback (por defecto: directorio donde se ejecuta el binario)
# "" → live-only (silence until SRT live), sin necesidad de carpeta
# FALLBACK_SOURCE=musica
# FALLBACK_SOURCE=""

# DSP: compresor/limitador de volumen estilo radio FM
# AUDIO_PROCESSING=false

# Crossfade entre canciones en segundos (0 = desactivado)
# CROSSFADE_SECONDS=1 (low-latency) / 2 legacy
# CROSSFADE_SECONDS=1

# Crossfade al entrar vivo (SRT) en segundos
# CROSSFADE_LIVE_SECONDS=0.2 (low-latency) / 2 legacy

# Tiempo mínimo de stream antes de cortar fallback (segundos, 0 = instant con low-latency)
# RTMP_MIN_LIVE_SECONDS=0

# Codificación MP3 nativa via FFI:
#   auto  → intenta nativo, fallback ffmpeg (recomendado)
#   true  → fuerza nativo
#   false → usa ffmpeg
# USE_NATIVE_LAME=auto

# Decodificación nativa de los decks via FFI (libavformat/libavcodec):
# elimina los procesos ffmpeg de reproducción (0 procesos externos en fallback)
#   auto  → intenta nativo, fallback ffmpeg por pista (recomendado)
#   true  → fuerza nativo
#   false → usa ffmpeg CLI
# USE_NATIVE_DECODE=auto

# Low-latency pipeline (prebuffer 8K, crossfade corto, SRT rcvlatency 20ms)
# LOW_LATENCY=true

# Dual-tier per-listener: mp3 320k + opus 96k, clientes eligen /stream?format=opus (10× eficiencia)
# ENABLE_OPUS_TIER=true
# OPUS_TIER_BITRATE_KBPS=96
